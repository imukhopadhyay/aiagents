# PostgreSQL connection (matches docker-compose.yml). On Neon, use the pooled
# connection string here.
DATABASE_URL="postgresql://hr:hr@localhost:5432/hr_app?schema=public"
# Optional direct (non-pooled) connection used by migrations. Set this on Neon.
# DIRECT_URL=""

# Auth.js — generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL of the app, used for redirects and email links. On Vercel it
# can be left unset; the project's production domain is used instead.
AUTH_URL="http://localhost:3000"

# Seeding. In production only roles, permissions, leave types and the admin
# account are created, and SEED_ADMIN_PASSWORD must be a unique password of
# 12+ characters. Set SEED_DEMO_DATA=true to also load the demo organization.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_PASSWORD="ChangeMe123!"
# SEED_DEMO_DATA="true"

# File storage. With BLOB_READ_WRITE_TOKEN set (Vercel Blob), uploads go to a
# private blob store; otherwise they're written to STORAGE_DIR on local disk.
STORAGE_DIR="storage"
# BLOB_READ_WRITE_TOKEN=""
