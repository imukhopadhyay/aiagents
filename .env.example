# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://hr:hr@localhost:5432/hr_app?schema=public"

# Auth.js — generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL of the app; used for password reset links. Required in production.
AUTH_URL="http://localhost:3000"

# Seed accounts (development only)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_PASSWORD="ChangeMe123!"
